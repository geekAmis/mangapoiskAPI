# ---------------------------------------------------------------------------
# MangaPoisk Reborn — local development defaults
# Copy to .env and adjust.  NEVER commit the real .env.
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
DEBUG=true

# Shared secrets (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_TOKEN=change-me-to-another-long-random-string

# Databases.  Compose overrides these with postgresql+asyncpg URLs.
CATALOG_DATABASE_URL=sqlite+aiosqlite:///./data/catalog.db
LIBRARY_DATABASE_URL=sqlite+aiosqlite:///./data/library.db
REDIS_URL=

# Public links (used by notifications and docs).  Production requires HTTPS
# for both values; HTTP is only for local development.
PUBLIC_WEB_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,capacitor://localhost,https://localhost

# Service map (used by gateway and scheduler).
PARSER_URL=http://localhost:8001
CATALOG_URL=http://localhost:8002
LIBRARY_URL=http://localhost:8003
MEDIA_URL=http://localhost:8004
CONTROL_URL=http://localhost:8005
NOTIFIER_URL=http://localhost:8006

# Admin panel / server manager
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_TOKEN_MINUTES=60
CONTROL_SECRET_KEY=change-me-control-secret
CONTROL_PUBLIC_URL=http://localhost:8005
DEPLOY_SOURCE_URL=https://github.com/geekAmis/mangapoiskAPI/archive/refs/heads/main.tar.gz
SERVER_HEALTH_INTERVAL_SECONDS=30

# Scraper politeness.  Keep these values conservative.
SCRAPER_REQUESTS_PER_MINUTE=30
SCRAPER_CACHE_TTL_SECONDS=600

# Optional session cookies for sources that show more content to signed-in
# users.  Leave empty for anonymous public access.  Do not commit real values.
MANGAPOISK_COOKIE=
MANGALIB_COOKIE=
REMANGA_COOKIE=

# Explicit opt-in for adapters disabled by default (robots/verification):
# comma-separated codes, e.g. "remanga,readmanga,mangadex".  Do not enable a
# source unless you are allowed to use it.
PARSER_ENABLED_SOURCES=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Export storage
MEDIA_CACHE_DIR=./data/media-cache
EXPORT_DIR=./data/exports
EXPORT_TTL_HOURS=48

# Persistent chapter archive.  When the paths below are empty they derive from
# MEDIA_CACHE_DIR (./data/archives.db and ./data/chapter-archives), which also
# keeps them inside the media Docker volume.  Small chapters are stored in
# SQLite; larger ones become ZIP files.
# ARCHIVE_DB=./data/archives.db
# ARCHIVE_DIR=./data/chapter-archives
ARCHIVE_DB_THRESHOLD_BYTES=1048576
# 25 GiB; the LRU sweep runs hourly, at startup and after each new archive.
ARCHIVE_MAX_BYTES=26843545600
ARCHIVE_PRUNE_INTERVAL_SECONDS=3600

# Image cache (originals, reader variants and JSON sidecars).  Catalogue
# metadata is stored by the catalog service and is never evicted here.
# 10 GiB default; set 0 to keep the cache unlimited.  Cold images are evicted
# hourly; covers are re-downloaded on demand.
MEDIA_CACHE_MAX_BYTES=10737418240
MEDIA_CACHE_PRUNE_INTERVAL_SECONDS=3600
MEDIA_CACHE_PRUNE_MIN_AGE_SECONDS=300

# Optional comma-separated allowlist of image CDN hosts (recommended in
# production).  Empty means "any public http(s) host that is not private".
MEDIA_ALLOWED_HOSTS=static2.mangapoisk.me,img2.imglib.info,img3.cdnlibs.org

# Rate limits (gateway)
GATEWAY_RATE_LIMIT_PER_MINUTE=240
GATEWAY_SEARCH_LIMIT_PER_MINUTE=60
GATEWAY_IMPORT_LIMIT_PER_MINUTE=10
