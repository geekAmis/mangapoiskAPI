# ---------------------------------------------------------------------------
# MangaPoisk Reborn — local development defaults
# Copy to .env and adjust.  NEVER commit the real .env.
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
DEBUG=true

# Shared secrets (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_TOKEN=change-me-to-another-long-random-string

# Databases.  Compose overrides these with postgresql+asyncpg URLs.
CATALOG_DATABASE_URL=sqlite+aiosqlite:///./data/catalog.db
# Background search normalization (v1.2 #63). Startup is schema-only; these
# control the resumable worker. Keep the batch small on SQLite.
SEARCH_BACKFILL_ENABLED=true
SEARCH_BACKFILL_BATCH_SIZE=500
SEARCH_BACKFILL_LEASE_SECONDS=120
SEARCH_BACKFILL_YIELD_SECONDS=0.01
SEARCH_BACKFILL_MAX_RETRIES=5
# Public URL slug backfill (issue #38).  Same pattern: additive column, small
# committed batches, no startup blocking.
URL_SLUG_BACKFILL_ENABLED=true
URL_SLUG_BACKFILL_BATCH_SIZE=500
URL_SLUG_BACKFILL_YIELD_SECONDS=0.05
# Catalogue list performance (#68).  PRAGMA optimize with a bounded
# analysis_limit keeps planner stats fresh without a full 21s ANALYZE.
STATS_OPTIMIZE_ENABLED=true
STATS_OPTIMIZE_INTERVAL_SECONDS=900
SLOW_QUERY_MS=500
LIST_LATENCY_WINDOW=512
LIBRARY_DATABASE_URL=sqlite+aiosqlite:///./data/library.db
REDIS_URL=

# Public links (used by notifications and docs).  Production requires HTTPS
# for both values; HTTP is only for local development.
PUBLIC_WEB_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8000
# Search Console / Yandex Webmaster meta verification.  Empty means the tag is
# omitted.  The web build and the gateway prerender both read these values.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
# Internal URL of the web nginx/static host.  The gateway proxies the SPA
# index.html to humans from this address while serving prerendered HTML to
# crawlers.  Production systemd example: http://127.0.0.1:8088
WEB_INTERNAL_URL=
# Yandex Metrika (#85).  Build-time counter id; empty disables the loader and
# all requests to mc.yandex.ru.  VITE_YANDEX_METRIKA_ID is accepted as a local
# alias in apps/web/.env.  Rebuild the web image after changing this value:
#   docker compose build web && docker compose up -d web
YANDEX_METRIKA_ID=
# Anonymous traffic counting: visitor ids are HMAC-SHA256 hashed with this
# secret before they are stored.  Empty falls back to JWT_SECRET.  A dedicated
# random value is recommended.  Retention is 90 days by default.
TRAFFIC_HASH_SECRET=
TRAFFIC_RETENTION_DAYS=90
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,capacitor://localhost,https://localhost

# Юридические страницы (/terms, /privacy, /dmca, /contacts, /age).
# Эти значения встраиваются в web-сборку. Пустые значения дают явную
# заглушку «заполните ... перед запуском», а не вымышленный контакт.
# После изменения обязательно пересоберите web-образ:
#   docker compose build web && docker compose up -d web
LEGAL_CONTACT_EMAIL=
LEGAL_OWNER_NAME=
LEGAL_JURISDICTION=

# Yandex ID OAuth 2.0 (#67).  Primary configuration lives encrypted in the
# control DB and is managed from Admin -> Интеграции -> Яндекс ID.  These values
# are a bootstrap fallback only while the DB has no values; once DB values
# exist, the DB wins.  Leave empty to disable.  Never commit real values.
# Production redirect URI (no trailing slash):
# https://85.192.37.58.nip.io:8443/api/v1/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=
# Capacitor SPA origin used after the callback (default https://localhost).
# YANDEX_APP_RETURN_URL=https://localhost

# Service map (used by gateway and scheduler).
PARSER_URL=http://localhost:8001
CATALOG_URL=http://localhost:8002
LIBRARY_URL=http://localhost:8003
MEDIA_URL=http://localhost:8004
CONTROL_URL=http://localhost:8005
NOTIFIER_URL=http://localhost:8006
COMMENTS_URL=http://localhost:8109

# Admin panel / server manager
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_TOKEN_MINUTES=60
CONTROL_SECRET_KEY=change-me-control-secret
CONTROL_PUBLIC_URL=http://localhost:8005
DEPLOY_SOURCE_URL=https://github.com/geekAmis/mangapoiskAPI/archive/refs/heads/main.tar.gz
SERVER_HEALTH_INTERVAL_SECONDS=30

# Control deploy safety.  Slow catalog migrations are allowed to finish;
# silent SSH streams are bounded; stale running jobs are failed/cancelled.
DEPLOY_TIMEOUT_SECONDS=3600
DEPLOY_HEALTH_TIMEOUT_SECONDS=600
DEPLOY_HEALTH_POLL_SECONDS=2
DEPLOY_READ_TIMEOUT_SECONDS=900
DEPLOY_STALE_JOB_SECONDS=1800
# Optional command run after install and before service restart.
DEPLOY_PRE_START_COMMAND=
DEPLOY_PRE_START_TIMEOUT_SECONDS=1800

# Scraper politeness.  Keep these values conservative.
SCRAPER_REQUESTS_PER_MINUTE=36
SCRAPER_CACHE_TTL_SECONDS=600

# Catalogue crawler (scheduler).  Retries and circuit breaking are bounded so
# a blocked source is paused instead of being hammered every 15 minutes.
CATALOGUE_CRAWL_ENABLED=true
CATALOGUE_SOURCES=mangapoisk,mangalib,remanga
CATALOGUE_CRAWL_DELAY_SECONDS=1.75
CATALOGUE_PAGE_RETRIES=2
CATALOGUE_FAILURE_THRESHOLD=3
CATALOGUE_CIRCUIT_BASE_SECONDS=900
CATALOGUE_CIRCUIT_MAX_SECONDS=86400
CATALOGUE_ENRICHMENT_CONCURRENCY=3
CATALOGUE_ENRICHMENT_BATCH_SIZE=100
CATALOGUE_ENRICHMENT_FAILURE_THRESHOLD=5
CATALOGUE_METADATA_REFRESH_BATCH=100
CATALOGUE_METADATA_REFRESH_MAX_BACKLOG=5000

# Optional session cookies for sources that show more content to signed-in
# users.  Leave empty for anonymous public access.  Do not commit real values.
MANGAPOISK_COOKIE=
MANGALIB_COOKIE=
REMANGA_COOKIE=

# Explicit opt-in for adapters disabled by default (robots/verification):
# comma-separated codes, e.g. "remanga,readmanga,mangadex".  Do not enable a
# source unless you are allowed to use it.
PARSER_ENABLED_SOURCES=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Operational alerts use this chat when set; otherwise TELEGRAM_CHAT_ID.
ALERT_CHAT_ID=

# Observability (#54/#58).  /metrics is open on loopback by default.  Set a
# token only when a remote scraper reaches the service over a network.
METRICS_TOKEN=
# Status file written by scripts/ops/mangapoisk-backup.sh (no secrets).
# The backup script and gateway read the same path in production.
BACKUP_STATUS_FILE=/var/lib/mangapoisk-backup/status.json
OBSERVABILITY_REFRESH_SECONDS=30

# Watchdog (systemd timer, scripts/ops/mangapoisk-watchdog.py).
WATCHDOG_GATEWAY_METRICS_URL=http://127.0.0.1:8100/metrics?format=json
WATCHDOG_STATE_FILE=/var/lib/mangapoisk-watchdog/state.json
WATCHDOG_BACKUP_STATUS_FILE=/var/lib/mangapoisk-backup/status.json
WATCHDOG_BACKUP_REQUIRED=1
WATCHDOG_DISK_PATH=/
WATCHDOG_COOLDOWN_SECONDS=3600

# Notifications / Web Push (issue #42).
# Generate VAPID keys once (never commit the private key):
#   npx web-push generate-vapid-keys
# or with Python (after installing services/notifier/requirements.txt):
#   python -c "from py_vapid import Vapid; from cryptography.hazmat.primitives import serialization as s; v=Vapid(); v.generate_keys(); print(v.private_key.private_numbers().private_value.to_bytes(32,'big').hex()); print(v.public_key.public_bytes(s.Encoding.X962,s.PublicFormat.UncompressedPoint).hex())"
# Put the private key into VAPID_PRIVATE_KEY and the public key into
# VAPID_PUBLIC_KEY.  Both accept the standard base64url form printed by
# `npx web-push`; PEM is accepted for the private key as well.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_ENABLED=true
PUSH_MAX_PER_HOUR=10
PUSH_TTL_SECONDS=86400
# Optional global quiet hours in UTC (user settings override these).
PUSH_QUIET_HOURS_START=
PUSH_QUIET_HOURS_END=
# Only these push services may be used as subscription endpoints (SSRF guard).
# google.com/googleapis.com cover Chrome FCM shard hosts such as jmt17.google.com.
PUSH_ENDPOINT_ALLOWED_HOSTS=google.com,googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,notify.windows.com,web.push.apple.com,push.apple.com

# Chapter notification fan-out from the scheduler.
CHAPTER_NOTIFICATIONS_ENABLED=true
CHAPTER_NOTIFICATIONS_PUSH_ENABLED=true

# Local SQLite paths when not overridden by Docker.
NOTIFIER_DATABASE_URL=sqlite+aiosqlite:///./data/notifier.db
COMMENTS_DATABASE_URL=sqlite+aiosqlite:///./data/comments.db

# Export storage
MEDIA_CACHE_DIR=./data/media-cache
EXPORT_DIR=./data/exports
EXPORT_TTL_HOURS=48

# Persistent chapter archive.  When the paths below are empty they derive from
# MEDIA_CACHE_DIR (./data/archives.db and ./data/chapter-archives), which also
# keeps them inside the media Docker volume.  Small chapters are stored in
# SQLite; larger ones become ZIP files.
# ARCHIVE_DB=./data/archives.db
# ARCHIVE_DIR=./data/chapter-archives
ARCHIVE_DB_THRESHOLD_BYTES=1048576
# 25 GiB; the LRU sweep runs hourly, at startup and after each new archive.
ARCHIVE_MAX_BYTES=26843545600
ARCHIVE_PRUNE_INTERVAL_SECONDS=3600

# Image cache (originals, reader variants and JSON sidecars).  Catalogue
# metadata is stored by the catalog service and is never evicted here.
# 10 GiB default; set 0 to keep the cache unlimited.  Cold images are evicted
# hourly; covers are re-downloaded on demand.
MEDIA_CACHE_MAX_BYTES=10737418240
MEDIA_CACHE_PRUNE_INTERVAL_SECONDS=3600
MEDIA_CACHE_PRUNE_MIN_AGE_SECONDS=300

# Optional comma-separated allowlist of image CDN hosts (recommended in
# production).  Empty means "any public http(s) host that is not private".
MEDIA_ALLOWED_HOSTS=static2.mangapoisk.me,img2.imglib.info,img3.cdnlibs.org

# Rate limits (gateway)
GATEWAY_RATE_LIMIT_PER_MINUTE=240
GATEWAY_SEARCH_LIMIT_PER_MINUTE=60
GATEWAY_IMPORT_LIMIT_PER_MINUTE=10
