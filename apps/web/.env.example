# Базовый путь публичного API. По умолчанию используется /api/v1
# и dev-прокси Vite направляет запросы на http://localhost:8000.
# Для отдельного домена укажите полный URL, например:
# VITE_API_BASE=https://api.mangapoisk.example/api/v1
VITE_API_BASE=/api/v1

# Канонический публичный адрес сайта (для canonical/OG в SPA).
# VITE_SITE_URL=https://mangapoisk.example

# Юридические реквизиты. Значения встраиваются в сборку при `npm run build`.
# Оставьте пустыми для локальной разработки: страницы покажут явную заглушку.
# Для Docker используйте одноимённые переменные в корневом .env — они
# передаются как build args (см. docker-compose.yml).
LEGAL_CONTACT_EMAIL=
LEGAL_OWNER_NAME=
LEGAL_JURISDICTION=
